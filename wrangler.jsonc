{
  // One Worker serves everything: the React app (static assets), POST /api/chat and, from step 9, /mcp.
  //
  // Two setups:
  //   default      (npm run dev)     templates only, no Cloudflare account needed, works offline
  //   env "ai"     (npm run dev:ai)  Workers AI chooses the tools and writes the text; needs `npx wrangler login`
  //
  // Secrets are not in this file: MCP_TOKEN lives in .dev.vars locally (see .dev.vars.example)
  // and is set with `wrangler secret put MCP_TOKEN` for a deployed Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  // The Agents SDK's MCP handler uses AsyncLocalStorage (node:async_hooks).
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // Built by `npm run build` (Vite). Unknown paths fall back to index.html, so client routes work.
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths always go to the Worker code, never to a static file.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurora-db",
      // Created with `wrangler d1 create aurora-db`. `wrangler dev` keeps its own local copy (.wrangler/).
      "database_id": "8fafa7ec-34b8-4781-ba1f-ea7a4bb238fe",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Per-client request limits (see worker/src/http/rate-limit.ts). Period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    // "scripted": templates only, no model calls. The "ai" environment below switches to "llm".
    "NARRATIVE_PROVIDER": "scripted",
    // The demo's fixed "today", so the numbers never change.
    "DEMO_TODAY": "2026-11-17",
    // Pauses between streamed steps and words. The scripted narrative is instant, so the
    // stream is paced to look the way it will with a real model. Set both to "0" to disable.
    "STREAM_STEP_DELAY_MS": "450",
    "TEXT_TOKEN_DELAY_MS": "30"
  },

  "env": {
    // Wrangler does not copy bindings and vars into an environment, so they are repeated here.
    "ai": {
      // Deployed as "aurora" (not "aurora-ai"): https://aurora.<subdomain>.workers.dev
      "name": "aurora",
      // Workers AI always runs on Cloudflare, even in `wrangler dev`, so this needs a login.
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aurora-db",
          "database_id": "8fafa7ec-34b8-4781-ba1f-ea7a4bb238fe",
          "migrations_dir": "worker/migrations"
        }
      ],
      "ratelimits": [
        { "name": "CHAT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": {
        // The model chooses the tools and writes the text; rules and templates take over if it fails.
        "NARRATIVE_PROVIDER": "llm",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_TIMEOUT_MS": "15000",
        "DEMO_TODAY": "2026-11-17",
        "STREAM_STEP_DELAY_MS": "450",
        "TEXT_TOKEN_DELAY_MS": "30"
      }
    }
  }
}
